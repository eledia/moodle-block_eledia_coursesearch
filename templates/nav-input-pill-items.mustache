{{!
    @template block_eledia_coursesearch/nav-input-pill-items

    Renders Bootstrap pills (or a placeholder) inside a filter input container div.
    Used by category, tags, and custom field search inputs.

    Example context (json):
    {
        "placeholder": "Search...",
        "items": [
            {
                "name": "Category A",
                "type": "category",
                "index": 0,
                "cindex": 0
            }
        ]
    }
}}
{{^items}}
    <div class="text-muted w-100">{{placeholder}}</div>
{{/items}}

{{#hasitems}}
    <div class="text-muted small w-100">{{placeholder}}</div>
{{/hasitems}}

{{#items}}
    <button
        type="button"
        class="btn btn-primary rounded-pill d-inline-flex align-items-center gap-1 pill-input-cancelbtn"
        aria-label="{{#str}} removefilter, block_eledia_coursesearch, {{name}} {{/str}}"
        data-type="{{type}}"
        data-index="{{index}}"
        data-cindex="{{cindex}}"
    >
        <span class="text-truncate" style="min-width:0;">{{name}}</span>
        <span class="flex-shrink-0" aria-hidden="true">
            {{#pix}} e/cancel, core {{/pix}}
        </span>
    </button>
{{/items}}
