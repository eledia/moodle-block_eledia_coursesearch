{{!
    @template block_eledia_coursesearch/nav-display-selector

    This template renders display dropdown.

    Example context (json):
    {
        "layouts": [
            {
                "id": "cards",
                "name": "Cards",
                "icon": "fa-th-large",
                "active": true,
                "arialabel": "Cards view"
            },
            {
                "id": "list",
                "name": "List",
                "icon": "fa-list",
                "active": false,
                "arialabel": "List view"
            },
            {
                "id": "summary",
                "name": "Summary",
                "icon": "fa-align-justify",
                "active": false,
                "arialabel": "Summary view"
            }
        ]
    }
}}
<div class="btn-group ms-auto ml-auto ms-2 ml-2" role="group">
    {{#layouts}}
        <button
            class="btn btn-outline-primary eledia-courseseach-viewbtn {{#active}}active{{/active}}"
            data-display-option="display"
            data-value="{{id}}"
            data-pref="{{id}}"
            title="{{name}}"
            data-title="{{name}}"
            data-bs-title="{{name}}"
            data-toggle="tooltip"
            data-bs-toggle="tooltip"
            aria-label="{{arialabel}}"
            aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}"
        >
            <i class="fa {{icon}}" aria-hidden="true"></i>
        </button>
    {{/layouts}}
</div>
