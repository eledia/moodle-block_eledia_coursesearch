{{!
    @template block_eledia_coursesearch/view-list-boostunion

    Wraps theme_boost_union/courselistinglist for the list and summary views.
    Iterates over courses and delegates each to the single-course boost_union template.
    Used for both the 'list' and 'summary' display modes in boost_union style.

    Example context (json):
    {
        "courses": [
            {
                "id": 2,
                "fullname": "My Course",
                "viewurl": "https://moodlesite/course/view.php?id=2",
                "visible": true,
                "showcourseimage": true,
                "courseimage": "https://moodlesite/pluginfile/123/course/overviewfiles/img.jpg",
                "showcoursecategory": true,
                "coursecategory": "Category 1",
                "showcourseprogress": true,
                "hasprogress": true,
                "progress": 42,
                "progressstyleasbar": false,
                "showbuttons": true,
                "showcoursegoto": true
            }
        ]
    }
}}
<div class="theme_boost_union-courselisting theme_boost_union-courselisting-list">
    {{#courses}}
        {{> theme_boost_union/courselistinglist}}
    {{/courses}}
</div>
