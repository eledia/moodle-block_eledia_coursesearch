{{!
    @template block_eledia_coursesearch/main

    This template renders the main content area for the eledia_coursesearch block.

    Example context (json):
    {}
}}

<div id="block-eledia_coursesearch-{{uniqid}}" class="block-eledia_coursesearch block-cards" data-region="eledia_coursesearch" role="navigation">
    <hr class="mt-0"/>

    <div role="search" data-region="filter" class="align-items-center my-2" aria-label="{{#str}} aria:controls, block_eledia_coursesearch {{/str}}">
        <div class="row g-2 mb-1">
            <div class="col-sm-9 col-xs-12">
                {{> block_eledia_coursesearch/nav-search-widget }}
            </div>
            <div class="col-sm-3 col-xs-12">
                {{> block_eledia_coursesearch/nav-grouping-selector }}
            </div>
        </div>

        <div class="row g-2">
            {{> block_eledia_coursesearch/nav-customfield-selector }}
        </div>

        {{! Expansion content }}
        <div class="row g-2 mt-0 collapse customfields-collapse" id="filtercollapse">
            {{> block_eledia_coursesearch/nav-customfield-selector-collapse }}
            {{> block_eledia_coursesearch/nav-category-selector }}
            {{> block_eledia_coursesearch/nav-tags-selector }}
            {{!> block_eledia_coursesearch/nav-sort-selector }}
        </div>

        <div class="row mt-1">
            {{#options_top}}
                <div class="coursesearchitems row g-2 pe-3 pr-3 ps-3 pl-3 mt-2 w-100">
                    {{> block_eledia_coursesearch/nav-selected-option-items }}
                </div>
            {{/options_top}}

            <div class="search-extension col-12 mb-3 mt-2 d-flex">
                <div>
                    {{! Expansion trigger }}
                    <a
                        class="btn btn-primary me-3 mr-3"
                        data-bs-toggle="collapse"
                        data-toggle="collapse"
                        data-bs-target="#filtercollapse"
                        data-target="#filtercollapse"
                        role="button"
                        aria-expanded="false"
                        aria-controls="filtercollapse"
                    >
                        {{#str}} expandsearch, block_eledia_coursesearch {{/str}}
                    </a>

                    {{! Reset search trigger }}
                    <a
                        href="#"
                        class=""
                        data-action="resetsearch"
                    >
                        {{#str}} resetsearch, block_eledia_coursesearch {{/str}}
                    </a>
                </div>

                {{> block_eledia_coursesearch/nav-display-selector }}
            </div>

            {{#options_bottom}}
                <div class="coursesearchitems row g-2 pe-3 pr-3 ps-3 pl-3 w-100">
                    {{> block_eledia_coursesearch/nav-selected-option-items }}
                </div>
            {{/options_bottom}}
        </div>
    </div>

    <div class="container-fluid p-0">
        {{> block_eledia_coursesearch/courses-view }}
    </div>
</div>
{{#js}}
require(
[
    'jquery',
    'block_eledia_coursesearch/main',
],
function(
    $,
    Main
) {
    var root = $('#block-eledia_coursesearch-{{uniqid}}');
    Main.init(root);
});
{{/js}}
